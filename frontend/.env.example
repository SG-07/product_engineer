# Base URL of the webhook backend (no trailing slash).
# Example: https://txn-webhooks.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# "true" to use the in-browser mock API (no backend required).
# Can also be toggled at runtime from the Settings page.
VITE_USE_MOCK=true

# Optional: seconds the mock backend waits before marking a transaction PROCESSED.
VITE_MOCK_PROCESSING_SECONDS=30

# Optional local dev proxy (avoids CORS). Set VITE_API_BASE_URL=/api when using it.
# VITE_DEV_PROXY_TARGET=http://localhost:8000
