# Copy to .env for local development. NEVER commit the real .env (it is git-ignored).

# --- Database -------------------------------------------------------------
# Local quick start (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./local.db
# Production / Supabase - use the *Session pooler* connection string (Render has no IPv6):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Webhook security -----------------------------------------------------
# If set, a request carrying X-Razorpay-Signature must have a valid HMAC-SHA256 of the raw body.
WEBHOOK_SECRET=
# true = reject unsigned requests too (needs WEBHOOK_SECRET). Default false.
SIGNATURE_REQUIRED=false

# --- Processing -----------------------------------------------------------
PROCESSING_DELAY_SECONDS=30
MAX_ATTEMPTS=3
# Demo only: fraction (0-1) of processing attempts that fail on purpose.
SIMULATED_FAILURE_RATE=0

# --- HTTP / currency ------------------------------------------------------
# Comma-separated browser origins allowed to call the API (the frontend), or *
CORS_ORIGINS=http://localhost:5173
# Fixed exchange rates: INR per 1 unit. Must contain exactly INR, USD, EUR, GBP (INR must be 1).
FX_RATES_TO_INR={"INR": 1, "USD": 94.75, "EUR": 106.08, "GBP": 127.14}
FX_RATES_AS_OF=2026-11-03

LOG_LEVEL=INFO
